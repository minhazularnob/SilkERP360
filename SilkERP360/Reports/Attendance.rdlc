                    <Textbox Name="ATTN_STATUS">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Switch(
    Fields!ATTN_STATUS.Value = 0, "NONE",
    Fields!ATTN_STATUS.Value = 1, "PRESENT",
    Fields!ATTN_STATUS.Value = 2, "ABSENT",
    Fields!ATTN_STATUS.Value = 3, "LATE",
    Fields!ATTN_STATUS.Value = 4, "LATE_APPROVED",
    Fields!ATTN_STATUS.Value = 5, "HOLIDAY",
    Fields!ATTN_STATUS.Value = 6, "ON_LEAVE",
    Fields!ATTN_STATUS.Value = 7, "WEEKEND",
    Fields!ATTN_STATUS.Value = 8, "WORK_ON_HOLIDAY",
    Fields!ATTN_STATUS.Value = 9, "OUTSIDE_DUTY",
    Fields!ATTN_STATUS.Value = 10, "REPLACEMENT_DUTY",
    Fields!ATTN_STATUS.Value = 11, "ON_FOREIGN_TOUR",
    Fields!ATTN_STATUS.Value = 12, "ABSENT_NO_DATA_FOUND",
    Fields!ATTN_STATUS.Value = 13, "ABSENT_OVERRIDDEN_PRESENT",
    Fields!ATTN_STATUS.Value = 14, "SHIFT_CHANGE_HOLIDAY"
)</Value>
                              <Style>
                                <FontFamily>times New Roman</FontFamily>
                                <FontSize>8pt</FontSize>
                              </Style>
                            </TextRun>
